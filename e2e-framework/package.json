{
  "name": "portsentinel-e2e-framework",
  "version": "1.0.0",
  "description": "Enterprise Production-Ready 1,200 Test Automation Framework (Selenium, Appium, Vulnerability, Load)",
  "main": "tests/masterTestSuite.spec.js",
  "type": "module",
  "scripts": {
    "test": "mocha tests/masterTestSuite.spec.js --reporter mochawesome --reporter-options reportDir=reports,reportFilename=index",
    "test:selenium": "mocha tests/masterTestSuite.spec.js --grep 'Suite 1'",
    "test:appium": "mocha tests/masterTestSuite.spec.js --grep 'Suite 2'",
    "test:security": "mocha tests/masterTestSuite.spec.js --grep 'Suite 3'",
    "test:load": "mocha tests/masterTestSuite.spec.js --grep 'Suite 4'"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "chai": "^5.1.0",
    "mocha": "^10.3.0",
    "mochawesome": "^7.1.3",
    "selenium-webdriver": "^4.18.1",
    "webdriverio": "^8.32.4"
  }
}
